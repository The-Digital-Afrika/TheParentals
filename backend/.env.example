DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/theparentals?schema=public"
PORT=5000
JWT_SECRET=change_this_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=The Parentals Admin
JWT_EXPIRES=7d

# Required for enquiry emails.
# For Gmail, use an app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=The Parentals <your-email@gmail.com>

# Optional fallback recipient if a provider profile has no enquiry email.
ENQUIRY_TO=admin@example.com
