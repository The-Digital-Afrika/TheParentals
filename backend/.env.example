DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/theparentals?schema=public"
PORT=5000
JWT_SECRET=change_this_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=The Parentals Admin
JWT_EXPIRES=7d
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Payments. Use PAYMENT_MODE=mock until you add Paystack test/live keys.
PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/dashboard
PAYSTACK_PLUS_PLAN_CODE=

# Required for enquiry emails.
# For Gmail, use an app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=The Parentals <your-email@gmail.com>

# Optional fallback recipient if a provider profile has no enquiry email.
ENQUIRY_TO=admin@example.com
MAX_CONCURRENT_UPLOADS=4

# Social sign-in. The public IDs must also be added to the frontend build as
# VITE_GOOGLE_CLIENT_ID and VITE_FACEBOOK_APP_ID.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
